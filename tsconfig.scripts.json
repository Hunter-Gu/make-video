{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["skills/make-video/scripts"],
  "exclude": [
    "skills/make-video/scripts/mcp.mjs",
    "skills/make-video/scripts/ai.mjs",
    "skills/make-video/scripts/qa.mjs",
    "skills/make-video/scripts/assets.mjs"
  ]
}
