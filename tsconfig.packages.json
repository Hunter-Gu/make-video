{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/contracts/src",
    "packages/project/src",
    "packages/ai/src",
    "packages/assets/src",
    "packages/audio/src",
    "packages/mcp/src",
    "packages/qa/src",
    "packages/render/src",
    "packages/remotion/src",
    "packages/series/src",
    "packages/sources/src",
    "packages/project/test",
    "packages/ai/test",
    "packages/audio/test",
    "packages/mcp/test",
    "packages/qa/test",
    "packages/render/test",
    "packages/series/test",
    "packages/sources/test",
    "packages/remotion/test"
  ]
}
