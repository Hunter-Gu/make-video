{
  "name": "@make-video/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts http",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --minify --platform=node --format=esm --target=node22 --outfile=../../skills/make-video/scripts/mcp.mjs --banner:js='import {createRequire} from \"node:module\"; const require = createRequire(import.meta.url);'",
    "test": "pnpm build && tsx --test test/stdio.test.ts"
  },
  "dependencies": {
    "@make-video/ai": "workspace:*",
    "@make-video/audio": "workspace:*",
    "@make-video/assets": "workspace:*",
    "@make-video/contracts": "workspace:*",
    "@make-video/render": "workspace:*",
    "@make-video/qa": "workspace:*",
    "@make-video/sources": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opencode-ai/models": "^0.0.51",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
