{
  "name": "make-video",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Skill: turn local assets into a finished, mastered video with Remotion, FFmpeg, and optional Gemini narration/music.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hunter-Gu/make-video.git"
  },
  "homepage": "https://github.com/Hunter-Gu/make-video#readme",
  "bugs": {
    "url": "https://github.com/Hunter-Gu/make-video/issues"
  },
  "scripts": {
    "assets:link": "node skills/make-video/scripts/link-assets.mjs",
    "sources:ingest": "node skills/make-video/scripts/ingest-sources.mjs",
    "audio:verify": "node skills/make-video/scripts/ai.mjs verify-voiceover",
    "audio:prepare": "node skills/make-video/scripts/prepare-audio.mjs",
    "video:check": "node skills/make-video/scripts/run-video.mjs check",
    "video:qa": "node skills/make-video/scripts/qa-video.mjs",
    "roadmap:verify": "node skills/make-video/scripts/verify-roadmap.mjs",
    "render:silent": "node skills/make-video/scripts/run-video.mjs render:silent",
    "render": "node skills/make-video/scripts/render-final.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.workbench.json && tsc --noEmit -p tsconfig.packages.json"
  },
  "dependencies": {
    "@remotion/captions": "^4.0.499",
    "@remotion/cli": "^4.0.499",
    "@remotion/media": "^4.0.499",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.499"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
