{
  "name": "make-video",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Skill: turn local assets into a finished, mastered video with Remotion, FFmpeg, and optional Gemini narration/music.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hunter-Gu/make-video.git"
  },
  "homepage": "https://github.com/Hunter-Gu/make-video#readme",
  "bugs": {
    "url": "https://github.com/Hunter-Gu/make-video/issues"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @make-video/app --filter @make-video/mcp dev",
    "build:scripts": "pnpm --filter @make-video/ai --filter @make-video/assets --filter @make-video/audio --filter @make-video/qa --filter @make-video/render --filter @make-video/series --filter @make-video/sources --filter @make-video/mcp build",
    "generation:estimate": "node skills/make-video/scripts/ai.mjs estimate",
    "assets:link": "node skills/make-video/scripts/assets.mjs link",
    "example:install": "node skills/make-video/scripts/assets.mjs example",
    "series:verify": "node skills/make-video/scripts/series.mjs verify",
    "series:coverage": "node skills/make-video/scripts/series.mjs coverage",
    "sources:ingest": "node skills/make-video/scripts/sources.mjs ingest",
    "audio:prepare": "node skills/make-video/scripts/audio.mjs prepare",
    "video:qa": "node skills/make-video/scripts/qa.mjs video",
    "render:preview": "node skills/make-video/scripts/render.mjs preview",
    "render": "node skills/make-video/scripts/render.mjs final",
    "deliver": "node skills/make-video/scripts/render.mjs deliver",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.packages.json",
    "project:create": "node skills/make-video/scripts/assets.mjs create",
    "test": "pnpm build:scripts && tsx --test packages/ai/test/*.test.ts packages/assets/test/*.test.ts packages/audio/test/*.test.ts packages/mcp/test/*.test.ts packages/project/test/*.test.ts packages/qa/test/*.test.ts packages/remotion/test/*.test.ts packages/render/test/*.test.ts packages/series/test/*.test.ts packages/sources/test/*.test.ts"
  },
  "dependencies": {
    "@make-video/contracts": "workspace:*",
    "@remotion/captions": "^4.0.499",
    "@remotion/cli": "^4.0.499",
    "@remotion/media": "^4.0.499",
    "@make-video/remotion": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.499"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
